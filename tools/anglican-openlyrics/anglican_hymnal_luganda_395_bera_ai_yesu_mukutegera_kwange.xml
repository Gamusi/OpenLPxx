<?xml version='1.0' encoding='utf-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8">
  <properties>
    <titles>
      <title>BERA,AI YESU,MUKUTEGERA KWANGE</title>
    </titles>
    <songbooks>
      <songbook name="Anglican Hymnal (Luganda)" entry="395" />
    </songbooks>
    <verseOrder>v1</verseOrder>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Bera,ai Yesu,mu kutegera kwange,<br />Bera,ai Yesu,mu maso gange,<br />Bera,ai Yesu,mu kamwa kange,<br />Bera,ai Yesu,mu mwoyo gwange,<br />Bera mu kufa okunsanyusanga.</lines>
    </verse>
  </lyrics>
</song>