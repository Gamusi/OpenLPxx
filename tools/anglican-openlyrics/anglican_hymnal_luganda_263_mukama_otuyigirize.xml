<?xml version='1.0' encoding='utf-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8">
  <properties>
    <titles>
      <title>MUKAMA-OTUYIGIRIZE</title>
    </titles>
    <songbooks>
      <songbook name="Anglican Hymnal (Luganda)" entry="263" />
    </songbooks>
    <verseOrder>v1 v2</verseOrder>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>MUKAMA-otuyigirize<br />-Okusaba-n'okutya,<br />Twang'anga-abaana b'enfuufu,<br />-Okukusemberera.</lines>
    </verse>
    <verse name="v2">
      <lines>Tufudde bwe tutasaba;<br />Yesu,otusabire;<br />Bwe tuba tugenda gy'oli,<br />Ggwe otwanirize.</lines>
    </verse>
  </lyrics>
</song>